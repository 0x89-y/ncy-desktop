{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ncy",
  "version": "0.7.0",
  "identifier": "com.ncy.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ncy",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "../../ncy-core/pear-sidecar/node_modules/bare-runtime-win32-x64/bin/bare.exe": "pear-sidecar/node_modules/bare-runtime-win32-x64/bin/bare.exe",
      "../../ncy-core/pear-sidecar/out/ncy-pear-sidecar.bundle": "pear-sidecar/out/ncy-pear-sidecar.bundle",
      "../../ncy-core/pear-sidecar/out/node_modules": "pear-sidecar/out/node_modules",
      "../../ncy-core/pear-sidecar/THIRD_PARTY_NOTICES.md": "pear-sidecar/THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "compression": "lzma"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://0x89-y.xyz/ncy/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCQjNDOTM3Rjk0Qjc5OApSV1NZdDVSL2t6eTdEb0VNT2R5endYU2xUVGJXRHVWY0VxbVhESXVBZENZcklZZThUTFNXeVVpSwo="
    }
  }
}
